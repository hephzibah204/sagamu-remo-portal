{
  "expo": {
    "name": "Sagamu Remo Civic Portal",
    "slug": "sagamu-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#064e3b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sagamuremo.civicportal",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely log into your Sagamu Remo Civic Citizen account.",
        "NSLocationWhenInUseUsageDescription": "Your location is used to dispatch rapid security assistance and share live location during emergencies."
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#064e3b"
      },
      "package": "com.sagamuremo.civicportal",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Sagamu Remo Civic App to use Face ID."
        }
      ]
    ],
    "extra": {
      "appVariant": "citizen",
      "eas": {
        "projectId": "3f8dbc5a-7522-4fd1-a62e-d85aa3f0c724"
      }
    }
  }
}
